---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Spidergraph — OPSEC Field Manual"
  description="A 44-item behavioral OPSEC self-audit across six domains: social engineering, physical security, legal docs, discipline, and incident readiness."
  path="opsec-field-manual/"
  current="opsec"
  accent="amber"
>
  <link slot="head" rel="stylesheet" href={`${base}shared/tool-page.css`} />
  <link
    slot="head"
    rel="stylesheet"
    href={`${base}pages/opsec-field-manual.css`}
  />

  <div class="wrap">
    <header>
      <div>
        <div class="eyebrow">
          Field manual · 6 domains · <span id="itemCount">0</span> controls
        </div>
        <h1>
          Behavioral <span>&amp; OPSEC Audit</span>
        </h1>
        <div class="sub">
          The habit-based half of the stack — nothing here is a product you buy,
          it's a practice you either do or don't. Check off what's already true
          for you; everything unchecked is your action list, ranked by how much
          it actually matters.
        </div>
      </div>
      <button type="button" class="reset-btn" id="resetBtn">
        Reset audit
      </button>
    </header>

    <div class="domains-toolbar">
      <select id="sectionJump" class="section-jump" aria-label="Jump to domain">
        <option value="">Jump to domain…</option>
      </select>
    </div>

    <div class="layout">
      <div id="domains"></div>

      <div class="sidebar">
        <div class="card">
          <div class="card-title">Readiness readout</div>
          <svg
            id="radar"
            width="280"
            height="280"
            viewBox="0 0 280 280"
            aria-hidden="true"
          ></svg>
          <div class="score-row">
            <div>
              <div class="score-num" id="scoreNum">
                0%
              </div>
              <div class="score-label">overall readiness</div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-title">Summary</div>
          <div class="metric">
            <span class="k">Controls in place</span>
            <span class="v teal" id="mChecked">
              0/0
            </span>
          </div>
          <div class="metric">
            <span class="k">Critical gaps unchecked</span>
            <span class="v red" id="mCritGap">
              0
            </span>
          </div>
          <div class="metric">
            <span class="k">Weakest domain</span>
            <span class="v amber" id="mWeakest">
              —
            </span>
          </div>
        </div>

        <div class="card">
          <div class="card-title">Priority action list</div>
          <div id="gapList" class="gap-list"></div>
        </div>

        <div class="card">
          <div class="card-title">Export</div>
          <button
            type="button"
            id="reportBtn"
            style="display:block; width:100%; text-align:center; padding:11px; cursor:pointer; background:var(--surface3); border:1px solid var(--border); border-radius:8px; font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--text);"
          >
            Generate report ↓
          </button>
        </div>

        <div class="card">
          <div class="card-title">History</div>
          <p class="small">
            Save a dated checkpoint to compare your audit against past versions
            of itself.
          </p>
          <button
            type="button"
            id="snapshotBtn"
            class="reset-btn"
            style="width:100%; margin-bottom:12px;"
          >
            Save snapshot
          </button>
          <div id="historyList" class="history-list"></div>
        </div>
      </div>
    </div>

    <footer>
      <b>Companion tool:</b> product/tool selections (password manager, VPN, OS,
      etc.) live in the <b>Stack Builder</b>. This manual covers what that
      picker deliberately left out — the discipline layer. The AUD domain's
      broker-recheck item points to the <b>Broker Removal Tracker</b> for the
      actual site-by-site checklist. Full write-ups and the incident-response
      runbooks these controls feed into are in{' '}
      <b>personal-security-playbook.md</b>. Your checked/unchecked state stays
      in this browser only, in <code>localStorage</code> — nothing is sent
      anywhere, so it's still here next time you come back for the quarterly
      re-audit this manual's own AUD domain recommends. <b>Reset audit</b>{' '}
      clears it.
    </footer>
  </div>

  <button
    type="button"
    id="scrollTopBtn"
    class="scroll-top-btn"
    aria-label="Scroll to top"
  >
    ↑
  </button>

  <script src={`${base}shared/persist.js`} is:inline></script>
  <script src={`${base}shared/history.js`} is:inline></script>
  <script src={`${base}shared/opsec-scoring.js`} is:inline></script>
  <script src={`${base}pages/opsec-field-manual.js`} is:inline></script>
</BaseLayout>
