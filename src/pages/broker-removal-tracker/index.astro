---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Spidergraph — Broker Removal Tracker"
  description="Track your own opt-out requests across the major people-search and background-check sites — direct links to each site's own official removal page, tracked locally in your browser only."
  ogDescription="Track your own opt-out requests across the major people-search and background-check sites — direct links to each site's own official removal page."
  path="broker-removal-tracker/"
  current="broker-tracker"
  accent="red"
>
<style slot="head" is:global>
  /* Broker Removal Tracker-only overrides + layout. Shared tokens/nav/brand live in shared/.
     is:global — this page creates broker rows/history entries via JS at runtime. */
  body{padding-bottom:80px;}
  .wrap{max-width:1180px; margin:0 auto;}

  header{
    display:flex; flex-wrap:wrap; gap:24px; justify-content:space-between; align-items:flex-end;
    border-bottom:1px solid var(--border); padding-bottom:24px; margin-bottom:24px;
  }
  .eyebrow{font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:.16em; text-transform:uppercase;
    color:var(--red); margin-bottom:10px; display:flex; align-items:center; gap:8px;}
  .eyebrow::before{content:"";width:6px;height:6px;background:var(--red);border-radius:1px; display:inline-block;}
  h1{font-family:'Space Grotesk', sans-serif; font-size:clamp(28px,4vw,42px); font-weight:700; margin:0;
    letter-spacing:-.01em; line-height:1.05;}
  h1 span{color:var(--muted); font-weight:500;}
  .sub{color:var(--muted); font-size:14.5px; margin-top:10px; max-width:600px; line-height:1.5;}

  .reset-btn{
    font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--muted);
    background:var(--surface); border:1px solid var(--border); border-radius:8px;
    padding:10px 14px; cursor:pointer; height:fit-content; letter-spacing:.03em;
    transition:all .15s ease; appearance:none; -webkit-appearance:none; margin:0;
  }
  .reset-btn:hover{color:var(--text); border-color:#374252;}
  .reset-btn:focus-visible, #exportBtn:focus-visible{outline:2px solid var(--red); outline-offset:1px;}

  .intro-card{
    background:var(--surface); border:1px solid var(--border); border-radius:14px;
    padding:20px 22px; margin-bottom:24px; font-size:13.5px; line-height:1.65; color:var(--muted2);
  }
  .intro-card b{color:var(--text);}
  .intro-card .links{display:flex; flex-wrap:wrap; gap:10px; margin-top:14px;}
  .intro-card .links a{
    font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--text); text-decoration:none;
    background:var(--surface2); border:1px solid var(--border); border-radius:7px; padding:8px 12px;
    display:inline-flex; align-items:center; gap:6px; transition:all .15s ease;
  }
  .intro-card .links a:hover{border-color:#374252; background:var(--surface3);}

  .layout{display:grid; grid-template-columns:1fr 320px; gap:28px;}
  @media (max-width:900px){.layout{grid-template-columns:1fr;} .sidebar{order:-1;}}

  .list-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;}
  .list-head-title{font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted2);}

  .broker{
    background:var(--surface); border:1px solid var(--border); border-radius:14px;
    padding:16px 18px; margin-bottom:12px; display:flex; gap:14px; align-items:flex-start;
  }
  .broker.done{border-color:#3ddc9744;}
  .broker input[type=checkbox]{
    appearance:none; width:20px; height:20px; border-radius:6px; border:1.5px solid var(--muted2);
    background:var(--surface2); flex-shrink:0; margin-top:2px; cursor:pointer; position:relative;
    transition:all .15s ease;
  }
  .broker input[type=checkbox]:checked{background:var(--teal); border-color:var(--teal);}
  .broker input[type=checkbox]:checked::after{
    content:""; position:absolute; left:6px; top:2px; width:5px; height:10px;
    border:solid #0f1419; border-width:0 2px 2px 0; transform:rotate(45deg);
  }
  .broker-body{flex:1; min-width:0;}
  .broker-top{display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:5px;}
  .broker-name{font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:15.5px;}
  .broker.done .broker-name{color:var(--muted);}
  .method-tag{
    font-family:'IBM Plex Mono',monospace; font-size:9.5px; letter-spacing:.06em; text-transform:uppercase;
    padding:2px 7px; border-radius:5px; white-space:nowrap;
  }
  .method-form{color:var(--teal); background:var(--teal-dim); border:1px solid #3ddc9755;}
  .method-phone{color:var(--amber); background:var(--amber-dim); border:1px solid #e8a23d55;}
  .method-email{color:var(--red); background:var(--red-dim); border:1px solid #e0596b55;}
  .method-multi{color:var(--blue); background:var(--blue-dim); border:1px solid #5b8def55;}
  .broker-note{font-size:12.8px; color:var(--muted); line-height:1.55; margin-bottom:8px;}
  .broker-meta{display:flex; flex-wrap:wrap; gap:14px; align-items:center; font-size:12px;}
  .broker-meta a{color:var(--red); font-family:'IBM Plex Mono',monospace; font-size:12px; text-decoration:none; font-weight:500;}
  .broker-meta a:hover{text-decoration:underline;}
  .broker-time{color:var(--muted2); font-family:'IBM Plex Mono',monospace; font-size:11.5px;}
  .broker-verified{color:var(--muted2); font-family:'IBM Plex Mono',monospace; font-size:11px;}
  .flag{color:var(--amber); font-size:12px;}

  .sidebar{position:sticky; top:80px; align-self:start; display:flex; flex-direction:column; gap:16px;}
  /* Below the breakpoint above, .sidebar gets order:-1 and stacks above the main content
     in a single column. position:sticky no longer serves its side-by-side purpose there,
     and actively breaks the page: as the user scrolls, the "stuck" sidebar overlaps and
     obscures whatever main-content row happens to be underneath it (confirmed via
     Playwright elementFromPoint + screenshot — checklist items were unreadable/unclickable
     behind the sidebar cards). Un-stick it — this has to come *after* the base .sidebar
     rule above, not inside the earlier @media block next to `order:-1`, since same-specificity
     CSS resolves by source order regardless of media-query nesting; placed earlier, the
     later unconditional rule above would win and silently no-op this override. */
  @media (max-width:900px){ .sidebar{position:static; top:auto;} }
  .card{background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:20px;}
  .card-title{font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--muted2); margin-bottom:14px;}

  .progress-ring-wrap{display:flex; justify-content:center;}
  .score-row{display:flex; justify-content:space-between; align-items:baseline; margin-top:14px;}
  .score-num{font-family:'Space Grotesk',sans-serif; font-size:32px; font-weight:700;}
  .score-label{font-size:12px; color:var(--muted);}

  .metric{display:flex; justify-content:space-between; padding:10px 0; border-top:1px solid var(--border-soft); font-size:13px;}
  .metric:first-of-type{border-top:none;}
  .metric .k{color:var(--muted);}
  .metric .v{font-family:'IBM Plex Mono',monospace; font-weight:600;}
  .v.red{color:var(--red);} .v.amber{color:var(--amber);} .v.teal{color:var(--teal);}

  .card p.small{font-size:12.5px; color:var(--muted2); line-height:1.6; margin:0 0 12px;}
  .card p.small:last-child{margin-bottom:0;}
  .history-list{display:flex; flex-direction:column; gap:8px; max-height:220px; overflow-y:auto;}
  .history-item{background:var(--surface2); border:1px solid var(--border); border-radius:8px; padding:8px 10px; font-size:12px;}
  .history-item .h-date{font-family:'IBM Plex Mono',monospace; color:var(--muted2); font-size:10.5px; margin-bottom:3px;}
  .history-item .h-summary{color:var(--text); line-height:1.4;}
  .history-empty{font-size:12px; color:var(--muted2); font-style:italic;}
  .card a.card-link{
    display:block; text-align:center; padding:11px; cursor:pointer; background:var(--surface3);
    border:1px solid var(--border); border-radius:8px; font-family:'IBM Plex Mono',monospace;
    font-size:12px; color:var(--text); text-decoration:none; transition:all .15s ease;
  }
  .card a.card-link:hover{border-color:#374252;}
  button#exportBtn{width:100%;}

  footer{margin-top:32px; padding-top:20px; border-top:1px solid var(--border);
    font-size:12.5px; color:var(--muted2); line-height:1.6;}
  footer b{color:var(--muted);}
</style>

<div class="wrap">

  <header>
    <div>
      <div class="eyebrow">Self-audit · 16 broker requests tracked</div>
      <h1>Broker <span>Removal Tracker</span></h1>
      <div class="sub">Search your own name on each site below, then use that site's own official opt-out page to request removal. Check it off once submitted — nothing here is sent anywhere, this is just a local checklist for your own follow-through.</div>
    </div>
    <button type="button" class="reset-btn" id="resetBtn">Reset tracker</button>
  </header>

  <div class="intro-card">
    <b>Why this exists:</b> people-search sites like these compile profiles — name, address history, relatives, phone numbers, sometimes court records — from public records and data-broker feeds, then sell access to anyone searching a name. Opting out at the source removes a listing until the site's next data refresh; it doesn't stop the underlying record from existing. See <b>Domain 8: OSINT & Digital Footprint</b> in the Playbook for the full explanation of how these sites source data and why removals don't stick permanently.
    <div class="links">
      <a href="../playbook/#8-osint-digital-footprint">📖 Read the full explainer in the Playbook →</a>
      <a href="../privacy-stack-builder/#domain-digital-footprint">⚙️ Compare automated removal services (EasyOptOuts / DeleteMe / Optery) →</a>
    </div>
  </div>

  <div class="layout">
    <div>
      <div class="list-head"><span class="list-head-title">Sites</span></div>
      <div id="brokerList"></div>
    </div>

    <div class="sidebar">
      <div class="card">
        <div class="card-title">Progress</div>
        <div class="score-row">
          <div>
            <div class="score-num" id="scoreNum">0%</div>
            <div class="score-label">requests submitted</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Summary</div>
        <div class="metric"><span class="k">Requested</span><span class="v teal" id="mDone">0/13</span></div>
        <div class="metric"><span class="k">Not started</span><span class="v red" id="mTodo">13</span></div>
      </div>

      <div class="card">
        <div class="card-title">Long tail</div>
        <p class="small">This list covers the ~16 highest-traffic broker sites. Dozens more exist. For the full, actively-maintained free list, use Bazzell's workbook or EFF's opt-out guide.</p>
        <a class="card-link" href="https://inteltechniques.com/workbook.html" target="_blank" rel="noopener">IntelTechniques workbook ↗</a>
      </div>

      <div class="card">
        <div class="card-title">Export</div>
        <button type="button" id="exportBtn" class="reset-btn">Export progress ↓</button>
      </div>

      <div class="card">
        <div class="card-title">History</div>
        <p class="small">Save a dated checkpoint to compare your progress over time.</p>
        <button type="button" id="snapshotBtn" class="reset-btn" style="width:100%; margin-bottom:12px;">Save snapshot</button>
        <div id="historyList" class="history-list"></div>
      </div>
    </div>
  </div>

  <footer>
    <b>Companion pages:</b> the "why" behind this list lives in Domain 8 of the <b>Playbook</b>; if you'd rather pay a service to do this on a recurring cycle instead of manually, compare EasyOptOuts / DeleteMe / Optery in the <b>Stack Builder</b> (slot OSN-01). Opt-out URLs and processes change — each entry below shows the date it was last checked; report a broken link by opening an issue on the repo. Your checked/unchecked state stays in this browser only, in <code>localStorage</code> — nothing is sent anywhere, and no name, address, or search input is ever collected by this page.
  </footer>

</div>

<script src={`${base}shared/persist.js`} is:inline></script>
<script src={`${base}shared/history.js`} is:inline></script>
<script is:inline>
const BROKERS = [
  {id:"spokeo", name:"Spokeo", method:"form", methodLabel:"Self-service form",
    note:"Per-listing opt-out — you'll need to repeat this for each profile URL of yours that turns up.",
    url:"https://www.spokeo.com/optout", time:"24–48 hrs", verified:"2026-08-05"},
  {id:"beenverified", name:"BeenVerified", method:"form", methodLabel:"Form + email confirm",
    note:"Search by name/state to find your listing, then confirm removal via the emailed link.",
    url:"https://www.beenverified.com/app/optout/search", time:"~48 hrs", verified:"2026-08-05"},
  {id:"whitepages", name:"Whitepages", method:"phone", methodLabel:"Phone-verified",
    note:"Five-step suppression wizard; requires a phone number for an automated verification call. Removes the consumer People listing only, not government records.",
    url:"https://www.whitepages.com/suppression-requests", time:"Immediate–7 days", verified:"2026-08-05"},
  {id:"peopleconnect", name:"PeopleConnect network — Intelius, TruthFinder, USSearch, Instant Checkmate", method:"multi", methodLabel:"1 request → 4 sites",
    note:"One suppression request on this shared portal covers all four PeopleConnect-owned sites — no need to repeat it per brand. No confirmation email is sent; recheck manually after 48 hrs.",
    url:"https://suppression.peopleconnect.us/login", time:"~48 hrs to propagate", verified:"2026-08-05"},
  {id:"mylife", name:"MyLife", method:"email", methodLabel:"Form or email",
    note:"Use the CCPA opt-out form (works for all states, not just CA), or email privacy@mylife.com directly. Widely reported as the slowest and most persistent re-lister on this list — expect to resubmit.",
    url:"https://www.mylife.com/ccpa/index.pubview", time:"7–15 business days", verified:"2026-08-05", flag:"Notoriously resistant to permanent removal"},
  {id:"radaris", name:"Radaris", method:"form", methodLabel:"Self-service form",
    note:"Submit via the control panel, then verify by email.",
    url:"https://radaris.com/control/privacy", time:"1–14 days", verified:"2026-08-05"},
  {id:"peekyou", name:"PeekYou", method:"form", methodLabel:"Self-service form",
    note:"Submit your profile URL and email, then click the confirmation link PeekYou sends you.",
    url:"https://www.peekyou.com/about/contact/optout", time:"Up to 30 days", verified:"2026-08-05"},
  {id:"fastpeoplesearch", name:"FastPeopleSearch", method:"form", methodLabel:"Self-service form",
    note:"Find your listing, select \"Remove My Record,\" then confirm via the emailed link.",
    url:"https://www.fastpeoplesearch.com/optout", time:"~3 days", verified:"2026-08-05"},
  {id:"peoplefinders", name:"PeopleFinders", method:"form", methodLabel:"Self-service form",
    note:"The confirmation link PeopleFinders emails you expires in 24 hours — act on it promptly.",
    url:"https://www.peoplefinders.com/opt-out", time:"3+ days", verified:"2026-08-05"},
  {id:"nuwber", name:"Nuwber", method:"form", methodLabel:"Self-service form",
    note:"Find your listing, copy its URL into the removal page, then confirm by email.",
    url:"https://nuwber.com/removal/link", time:"A few days", verified:"2026-08-05"},
  {id:"checkpeople", name:"CheckPeople", method:"email", methodLabel:"Email confirm",
    note:"No ID upload required — just email confirmation.",
    url:"https://www.checkpeople.com/opt-out", time:"A few days", verified:"2026-08-05"},
  {id:"backgroundchecks", name:"BackgroundChecks.com", method:"email", methodLabel:"Email / footer form",
    note:"No single dedicated opt-out URL — check the privacy policy linked in the site footer for the current request form, or email info@backgroundchecks.com with your name plus phone or email to be matched.",
    url:"https://www.backgroundchecks.com/privacy-policy", time:"Varies", verified:"2026-08-05", flag:"Confirm you're on backgroundchecks.com — several similarly-named sites exist"},
  {id:"socialcatfish", name:"Social Catfish", method:"form", methodLabel:"Self-service form",
    note:"Standard \"Do Not Sell My Info\" request form.",
    url:"https://socialcatfish.com/opt-out/", time:"Up to 15 days", verified:"2026-08-05"},
  {id:"truepeoplesearch", name:"TruePeopleSearch", method:"email", methodLabel:"Email confirm",
    note:"Select \"the subject of the request\" for yourself, then confirm via the emailed link — it expires in 24 hours.",
    url:"https://www.truepeoplesearch.com/removal", time:"A few days", verified:"2026-08-06"},
  {id:"usphonebook", name:"USPhoneBook", method:"form", methodLabel:"Self-service form",
    note:"Confirmation link expires in 24 hours — check your email promptly after submitting.",
    url:"https://www.usphonebook.com/opt-out", time:"Up to 72 hrs", verified:"2026-08-06"},
  {id:"clustrmaps", name:"ClustrMaps", method:"form", methodLabel:"Self-service form",
    note:"Enter your name, email, listing URL, and address, then tick which fields to remove and submit.",
    url:"https://clustrmaps.com/bl/opt-out", time:"A few days", verified:"2026-08-06"},
];

const store = spidergraphStore("spidergraph-broker-tracker-v1");
const saved = store.load();
// Back-compat: pre-persist.js saves were the flat map itself, not {data, lastUpdated}.
let state = saved ? (saved.data !== undefined ? saved.data : saved) : {};

const listEl = document.getElementById("brokerList");

const methodClass = {form:"method-form", phone:"method-phone", email:"method-email", multi:"method-multi"};

BROKERS.forEach(b => {
  // <label>, not <div>: makes the whole row a tap target on mobile, not just the raw
  // 20x20px checkbox (which is below WCAG's 24x24px minimum on its own) — matches the
  // OPSEC Field Manual's checklist rows, which already use this pattern. Native label
  // click-forwarding correctly skips the "Open opt-out page" link inside it, so tapping
  // that still just navigates rather than also toggling the checkbox.
  const row = document.createElement("label");
  row.className = "broker" + (state[b.id] ? " done" : "");
  row.id = "row-" + b.id;
  row.innerHTML = `
    <input type="checkbox" id="cb-${b.id}" ${state[b.id] ? "checked" : ""} aria-label="Mark ${b.name} as requested">
    <div class="broker-body">
      <div class="broker-top">
        <span class="broker-name">${b.name}</span>
        <span class="method-tag ${methodClass[b.method]}">${b.methodLabel}</span>
      </div>
      <div class="broker-note">${b.note}${b.flag ? ` <span class="flag">⚠ ${b.flag}</span>` : ""}</div>
      <div class="broker-meta">
        <a href="${b.url}" target="_blank" rel="noopener">Open opt-out page →</a>
        <span class="broker-time">Est. ${b.time}</span>
        <span class="broker-verified">Checked ${b.verified}</span>
      </div>
    </div>
  `;
  listEl.appendChild(row);
  const cb = row.querySelector("input");
  cb.addEventListener("change", () => {
    state[b.id] = cb.checked;
    row.classList.toggle("done", cb.checked);
    store.save(state);
    render();
  });
});

function render(){
  let done = 0;
  BROKERS.forEach(b => { if(state[b.id]) done++; });
  const pct = Math.round((done/BROKERS.length)*100);
  document.getElementById("scoreNum").textContent = `${pct}%`;
  document.getElementById("mDone").textContent = `${done}/${BROKERS.length}`;
  document.getElementById("mTodo").textContent = BROKERS.length - done;
}

document.getElementById("resetBtn").addEventListener("click", () => {
  state = {};
  store.clear();
  document.querySelectorAll('#brokerList input[type=checkbox]').forEach(cb => {
    cb.checked = false;
    cb.closest('.broker').classList.remove('done');
  });
  render();
});

document.getElementById("exportBtn").addEventListener("click", () => {
  const now = new Date().toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'});
  let lines = [];
  lines.push("BROKER REMOVAL TRACKER — PROGRESS EXPORT");
  lines.push(`Generated ${now}`);
  lines.push("=".repeat(60));
  lines.push("");
  let done = 0;
  BROKERS.forEach(b => {
    const isDone = !!state[b.id];
    if(isDone) done++;
    lines.push(`[${isDone ? "x" : " "}] ${b.name}`);
    lines.push(`      ${b.url}`);
  });
  lines.push("");
  lines.push("-".repeat(60));
  lines.push(`Requested: ${done}/${BROKERS.length}`);
  lines.push("");
  lines.push("This list covers the highest-traffic broker sites only. For the");
  lines.push("full, actively-maintained free list: inteltechniques.com/workbook.html");
  lines.push("For an automated/recurring service instead: see the Stack Builder,");
  lines.push("slot OSN-01, at ../privacy-stack-builder/");

  const blob = new Blob([lines.join("\n")], {type:"text/plain"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `broker-removal-progress-${Date.now()}.txt`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
});

const history = spidergraphHistory("spidergraph-broker-tracker-v1");

function renderHistory(){
  const snapshots = history.list().slice().reverse();
  const el = document.getElementById("historyList");
  if(snapshots.length === 0){
    el.innerHTML = '<div class="history-empty">No snapshots yet — save one to start tracking progress over time.</div>';
    return;
  }
  el.innerHTML = snapshots.map(s => {
    const d = new Date(s.date).toLocaleDateString('en-US', {year:'numeric', month:'short', day:'numeric'});
    return `<div class="history-item"><div class="h-date">${d}</div><div class="h-summary">${s.summary}</div></div>`;
  }).join("");
}

document.getElementById("snapshotBtn").addEventListener("click", () => {
  const done = BROKERS.filter(b => state[b.id]).length;
  const pct = Math.round((done / BROKERS.length) * 100);
  const summary = `${done}/${BROKERS.length} sites requested (${pct}%)`;
  history.save(summary, state);
  renderHistory();
});

render();
renderHistory();
</script>
</BaseLayout>
