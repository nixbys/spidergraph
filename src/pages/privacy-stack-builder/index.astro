// Platform detection: guess desktop/mobile OS from the browser, default to the
// global-majority platforms (Windows, Android) rather than assuming Linux/iOS.
function detectPlatform(){
  const ua = navigator.userAgent || "";
  const uaData = navigator.userAgentData;
  let desktop = null, mobile = null;

  if(/android/i.test(ua)) mobile = "android";
  else if(/iphone|ipad|ipod/i.test(ua)) mobile = "ios";

  if(!mobile){
    if(uaData && uaData.platform){
      const p = uaData.platform.toLowerCase();
      if(p.includes("win")) desktop = "windows";
      else if(p.includes("mac")) desktop = "macos";
      else if(p.includes("linux")) desktop = "linux";
    } else {
      if(/windows/i.test(ua)) desktop = "windows";
      else if(/macintosh|mac os x/i.test(ua)) desktop = "macos";
      else if(/linux/i.test(ua)) desktop = "linux";
    }
  }
  return {desktop, mobile};
}

const store = spidergraphStore("spidergraph-stack-builder-v1");
const savedRaw = store.load();
// Back-compat: pre-persist.js saves were {target, platformState, state} directly, not {data, lastUpdated}.
const saved = savedRaw ? (savedRaw.data !== undefined ? savedRaw.data : savedRaw) : null;

let platformState = {desktop:"windows", mobile:"android"};
const detected = detectPlatform();
if(detected.desktop) platformState.desktop = detected.desktop;
if(detected.mobile) platformState.mobile = detected.mobile;
if(saved && saved.platformState){
  if(["windows","macos","linux"].includes(saved.platformState.desktop)) platformState.desktop = saved.platformState.desktop;
  if(["ios","android"].includes(saved.platformState.mobile)) platformState.mobile = saved.platformState.mobile;
}

function currentOptions(d){ return d.platformAxis ? d.platforms[platformState[d.platformAxis]].options : d.options; }
function currentRec(d){ return d.platformAxis ? d.platforms[platformState[d.platformAxis]].rec : d.rec; }

let target = (saved && [1,2,3].includes(saved.target)) ? saved.target : 2;
let state = {}; // id -> selected option id
DATA.forEach(d => {
  const fallback = currentOptions(d)[0].id;
  const savedVal = saved && saved.state ? saved.state[d.code] : undefined;
  state[d.code] = (savedVal && currentOptions(d).some(o => o.id === savedVal)) ? savedVal : fallback;
});

function persist(){
  store.save({target, platformState, state});
}

function populateSelect(d){
  const sel = document.getElementById(`sel-${d.code}`);
  sel.innerHTML = "";
  currentOptions(d).forEach(o => {
    const opt = document.createElement("option");
    opt.value = o.id;
    opt.textContent = o.label;
    sel.appendChild(opt);
  });
  sel.value = state[d.code];
}

function slugify(text){
  return text.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/[\s_]+/g, '-').replace(/^-+|-+$/g, '');
}

const rowsEl = document.getElementById("rows");
const jumpSel = document.getElementById("sectionJump");
let lastDomain = null;

DATA.forEach((d, idx) => {
  if(d.domain !== lastDomain){
    const h = document.createElement("div");
    h.className = "domain-title";
    h.textContent = d.domain;
    h.id = "domain-" + slugify(d.domain);
    rowsEl.appendChild(h);
    lastDomain = d.domain;

    const opt = document.createElement("option");
    opt.value = "#" + h.id;
    opt.textContent = d.domain;
    jumpSel.appendChild(opt);
  }
  const row = document.createElement("div");
  row.className = "row";
  row.innerHTML = `
    <div class="code-chip">${d.code}</div>
    <div class="row-main">
      <div class="name">${d.name}</div>
      <div class="note" id="note-${d.code}"></div>
    </div>
    <select id="sel-${d.code}"></select>
    <div class="status" id="status-${d.code}"></div>
  `;
  rowsEl.appendChild(row);

  populateSelect(d);
  const sel = row.querySelector(`#sel-${d.code}`);
  sel.addEventListener("change", () => {
    state[d.code] = sel.value;
    persist();
    render();
  });
});

document.getElementById("platformDesktop").value = platformState.desktop;
document.getElementById("platformMobile").value = platformState.mobile;
document.querySelectorAll("#tierBtns .tier-btn").forEach(b => {
  const isActive = parseInt(b.dataset.tier, 10) === target;
  b.classList.toggle("active", isActive);
  b.setAttribute("aria-pressed", isActive ? "true" : "false");
});

jumpSel.addEventListener("change", () => {
  if(!jumpSel.value) return;
  const target = document.querySelector(jumpSel.value);
  if(target) target.scrollIntoView({behavior:"smooth", block:"start"});
  jumpSel.value = "";
});

const scrollBtn = document.getElementById("scrollTopBtn");
window.addEventListener("scroll", () => {
  scrollBtn.classList.toggle("visible", window.scrollY > 400);
}, {passive:true});
scrollBtn.addEventListener("click", () => window.scrollTo({top:0, behavior:"smooth"}));

function onPlatformChange(axis, newValue){
  const affected = DATA.filter(d => d.platformAxis === axis);
  const prevTiers = affected.map(d => {
    const cur = currentOptions(d).find(o => o.id === state[d.code]);
    return cur ? cur.tier : 0;
  });
  platformState[axis] = newValue;
  affected.forEach((d, i) => {
    const newOptions = currentOptions(d);
    const matched = newOptions.find(o => o.tier === prevTiers[i]) || newOptions[0];
    state[d.code] = matched.id;
    populateSelect(d);
  });
  persist();
  render();
}

document.getElementById("platformDesktop").addEventListener("change", e => onPlatformChange("desktop", e.target.value));
document.getElementById("platformMobile").addEventListener("change", e => onPlatformChange("mobile", e.target.value));

document.querySelectorAll("#tierBtns .tier-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll("#tierBtns .tier-btn").forEach(b => { b.classList.remove("active"); b.setAttribute("aria-pressed", "false"); });
    btn.classList.add("active");
    btn.setAttribute("aria-pressed", "true");
    target = parseInt(btn.dataset.tier, 10);
    persist();
    render();
  });
});

document.getElementById("resetBtn").addEventListener("click", () => {
  target = 2;
  DATA.forEach(d => { state[d.code] = currentOptions(d)[0].id; populateSelect(d); });
  document.querySelectorAll("#tierBtns .tier-btn").forEach(b => {
    const isActive = parseInt(b.dataset.tier, 10) === target;
    b.classList.toggle("active", isActive);
    b.setAttribute("aria-pressed", isActive ? "true" : "false");
  });
  store.clear();
  render();
});

function getOption(d, id){ return currentOptions(d).find(o => o.id === id); }

function render(){
  let atTarget = 0, below = 0, gap = 0, cost = 0;
  const gapItems = [];

  DATA.forEach(d => {
    const cur = getOption(d, state[d.code]);
    const statusEl = document.getElementById(`status-${d.code}`);
    const noteEl = document.getElementById(`note-${d.code}`);
    cost += cur.tier > 0 ? cur.cost : 0;

    // if/else status logic
    if(cur.tier === 0){
      statusEl.textContent = "GAP";
      statusEl.className = "status gap";
      gap++;
      gapItems.push({name:d.name, msg:`Nothing set — start with: ${currentOptions(d)[1].label}`});
    } else if(cur.tier === target){
      statusEl.textContent = "OPTIMAL";
      statusEl.className = "status optimal";
      atTarget++;
    } else if(cur.tier < target){
      statusEl.textContent = "BELOW";
      statusEl.className = "status below";
      below++;
      const recOpt = currentOptions(d).find(o => o.tier === target);
      gapItems.push({name:d.name, msg:`Below target — consider: ${recOpt ? recOpt.label : currentRec(d)}`});
    } else {
      statusEl.textContent = "ABOVE";
      statusEl.className = "status above";
      atTarget++; // exceeding target still counts as covered
    }

    const verifiedTag = d.verified ? `<span class="verified-tag">✓ verified ${d.verified}</span>` : "";
    const legacyHtml = (d.legacyNotes || []).map(n => `<span class="legacy-note"><b>Legacy:</b> ${n}</span>`).join("");
    noteEl.innerHTML = `<b>Rec:</b> ${currentRec(d)}${verifiedTag}${legacyHtml}`;
  });

  document.getElementById("mAtTarget").textContent = `${atTarget}/${DATA.length}`;
  document.getElementById("mBelow").textContent = below;
  document.getElementById("mGap").textContent = gap;
  document.getElementById("mCost").textContent = `$${cost.toLocaleString()}`;
  document.getElementById("scoreNum").textContent = `${Math.round((atTarget/DATA.length)*100)}%`;

  const gapListEl = document.getElementById("gapList");
  gapListEl.innerHTML = "";
  if(gapItems.length === 0){
    gapListEl.innerHTML = `<div class="empty-gaps">✓ Every slot meets or exceeds the ${TIERS[target]} target.</div>`;
  } else {
    gapItems.slice(0,6).forEach(g => {
      const div = document.createElement("div");
      div.className = "gap-item";
      div.innerHTML = `<span class="dot"></span><span><b>${g.name}:</b> ${g.msg}</span>`;
      gapListEl.appendChild(div);
    });
  }

  drawRadar();
}

function drawRadar(){
  const svg = document.getElementById("radar");
  svg.innerHTML = "";
  const cx = 140, cy = 140, maxR = 105;
  const n = DATA.length;
  const levels = 3;

  const ns = "http://www.w3.org/2000/svg";
  function pt(i, r){
    const angle = (Math.PI * 2 * i / n) - Math.PI/2;
    return [cx + r * Math.cos(angle), cy + r * Math.sin(angle)];
  }

  // grid rings
  for(let l=1; l<=levels; l++){
    const r = (maxR/levels)*l;
    let points = [];
    for(let i=0;i<n;i++){ points.push(pt(i,r).join(",")); }
    const poly = document.createElementNS(ns,"polygon");
    poly.setAttribute("points", points.join(" "));
    poly.setAttribute("fill","none");
    poly.setAttribute("stroke", l===levels ? "#2b3542" : "#20293380");
    poly.setAttribute("stroke-width","1");
    svg.appendChild(poly);
  }
  // spokes
  for(let i=0;i<n;i++){
    const [x,y] = pt(i,maxR);
    const line = document.createElementNS(ns,"line");
    line.setAttribute("x1",cx); line.setAttribute("y1",cy);
    line.setAttribute("x2",x); line.setAttribute("y2",y);
    line.setAttribute("stroke","#20293380"); line.setAttribute("stroke-width","1");
    svg.appendChild(line);
  }

  // target tier reference shape (dashed)
  let tpoints = [];
  for(let i=0;i<n;i++){ tpoints.push(pt(i,(maxR/levels)*target).join(",")); }
  const tpoly = document.createElementNS(ns,"polygon");
  tpoly.setAttribute("points", tpoints.join(" "));
  tpoly.setAttribute("fill","none");
  tpoly.setAttribute("stroke","#5b8def");
  tpoly.setAttribute("stroke-width","1.5");
  tpoly.setAttribute("stroke-dasharray","3,4");
  tpoly.setAttribute("opacity","0.6");
  svg.appendChild(tpoly);

  // current coverage shape (filled)
  let cpoints = [];
  DATA.forEach((d,i) => {
    const cur = getOption(d, state[d.code]);
    const r = (maxR/levels) * cur.tier;
    cpoints.push(pt(i,r));
  });
  const cpoly = document.createElementNS(ns,"polygon");
  cpoly.setAttribute("points", cpoints.map(p=>p.join(",")).join(" "));
  cpoly.setAttribute("fill","#3ddc9733");
  cpoly.setAttribute("stroke","#3ddc97");
  cpoly.setAttribute("stroke-width","2");
  cpoly.setAttribute("stroke-linejoin","round");
  svg.appendChild(cpoly);

  cpoints.forEach(([x,y]) => {
    const c = document.createElementNS(ns,"circle");
    c.setAttribute("cx",x); c.setAttribute("cy",y); c.setAttribute("r","2.5");
    c.setAttribute("fill","#3ddc97");
    svg.appendChild(c);
  });

  // axis labels (codes only, kept short)
  DATA.forEach((d,i) => {
    const [x,y] = pt(i, maxR + 16);
    const t = document.createElementNS(ns,"text");
    t.setAttribute("x",x); t.setAttribute("y",y);
    t.setAttribute("fill","#5e6b7c");
    t.setAttribute("font-size","8.5");
    t.setAttribute("font-family","IBM Plex Mono, monospace");
    t.setAttribute("text-anchor","middle");
    t.setAttribute("dominant-baseline","middle");
    t.textContent = d.code;
    svg.appendChild(t);
  });
}

document.getElementById("reportBtn").addEventListener("click", generateReport);

function generateReport(){
  const now = new Date().toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'});
  let atTarget=0, below=0, gap=0, cost=0;
  let lines = [];
  const platformLabels = {windows:"Windows", macos:"macOS", linux:"Linux", ios:"iOS", android:"Android"};
  lines.push("PRIVACY & SECURITY STACK — RECOMMENDATIONS REPORT");
  lines.push(`Generated ${now} · Target tier: ${TIERS[target]}`);
  lines.push(`Platform: Desktop = ${platformLabels[platformState.desktop]}, Mobile = ${platformLabels[platformState.mobile]}`);
  lines.push("=".repeat(60));
  lines.push("");

  DATA.forEach(d => {
    const cur = getOption(d, state[d.code]);
    cost += cur.tier > 0 ? cur.cost : 0;
    let status, action;
    if(cur.tier === 0){
      status = "CRITICAL GAP"; gap++;
      const first = currentOptions(d)[1];
      action = `Start with: ${first.label}. ${currentRec(d)}`;
    } else if(cur.tier === target){
      status = "OPTIMAL"; atTarget++;
      action = "No action needed at current target tier.";
    } else if(cur.tier < target){
      status = "BELOW TARGET"; below++;
      const recOpt = currentOptions(d).find(o => o.tier === target);
      action = `Upgrade to: ${recOpt ? recOpt.label : currentRec(d)}. ${currentRec(d)}`;
    } else {
      status = "EXCEEDS TARGET"; atTarget++;
      action = "Already above target tier — no action needed.";
    }
    lines.push(`[${d.code}] ${d.name}`);
    lines.push(`  Current:  ${cur.label}`);
    lines.push(`  Status:   ${status}`);
    lines.push(`  Guidance: ${action}`);
    lines.push("");
  });

  lines.push("-".repeat(60));
  lines.push("SUMMARY");
  lines.push(`  Slots at/above target: ${atTarget}/${DATA.length}`);
  lines.push(`  Slots below target:    ${below}`);
  lines.push(`  Critical gaps (none):  ${gap}`);
  lines.push(`  Est. recurring cost:   $${cost.toLocaleString()}/yr`);
  lines.push(`  Overall completeness:  ${Math.round((atTarget/DATA.length)*100)}%`);
  lines.push("");
  lines.push("-".repeat(60));
  lines.push("SOURCES");
  lines.push("  Recommendations derived from Privacy Guides (privacyguides.org),");
  lines.push("  The New Oil (thenewoil.org), IntelTechniques (inteltechniques.com),");
  lines.push("  Techlore, Consumer Reports data-removal testing, and official vendor");
  lines.push("  documentation. Full bibliography and further-reading list:");
  lines.push("  see recommendations-report.md.");
  lines.push("");
  lines.push("  This space moves fast — re-verify pricing and tier details at each");
  lines.push("  vendor's site before purchasing, and re-run this audit periodically.");

  const blob = new Blob([lines.join("\n")], {type:"text/plain"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `stack-report-${TIERS[target].toLowerCase()}-${Date.now()}.txt`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

const history = spidergraphHistory("spidergraph-stack-builder-v1");

function renderHistory(){
  const snapshots = history.list().slice().reverse();
  const el = document.getElementById("historyList");
  if(snapshots.length === 0){
    el.innerHTML = '<div class="history-empty">No snapshots yet — save one to start tracking your build over time.</div>';
    return;
  }
  el.innerHTML = snapshots.map(s => {
    const d = new Date(s.date).toLocaleDateString('en-US', {year:'numeric', month:'short', day:'numeric'});
    return `<div class="history-item"><div class="h-date">${d}</div><div class="h-summary">${s.summary}</div></div>`;
  }).join("");
}

document.getElementById("snapshotBtn").addEventListener("click", () => {
  let atTarget = 0, gap = 0;
  DATA.forEach(d => {
    const cur = getOption(d, state[d.code]);
    if(cur.tier === 0) gap++;
    else if(cur.tier >= target) atTarget++;
  });
  const tierName = TIERS[target] || "—";
  const summary = `Target: ${tierName} tier · ${atTarget}/${DATA.length} at target, ${gap} gaps`;
  history.save(summary, {target, platformState, state});
  renderHistory();
});

render();
renderHistory();
</script>
