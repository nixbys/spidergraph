---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marked } from 'marked';
import md from '../../content/recommendations-report.md?raw';

const contentHtml = marked.parse(md) as string;
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Spidergraph — Recommendations Report"
  description="Top picks per category, best practices to close any gap to 100%, and full source documentation — sourced from Privacy Guides, The New Oil, IntelTechniques, Techlore, and Consumer Reports."
  path="report/"
  current="report"
  accent="teal"
>
<link rel="stylesheet" href={`${base}shared/doc-page.css`} slot="head">
<div class="doc-wrap">
  <div class="doc-head">
    <div class="eyebrow">Generated synthesis</div>
    <select id="sectionJump" class="section-jump" aria-label="Jump to section">
      <option value="">Jump to section…</option>
    </select>
  </div>
  <div id="content" set:html={contentHtml}></div>
</div>
<button type="button" id="scrollTopBtn" class="scroll-top-btn" aria-label="Scroll to top">↑</button>
<script src={`${base}shared/doc-page.js`} is:inline></script>
</BaseLayout>
