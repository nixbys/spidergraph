---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Spidergraph — Breach Check Tracker"
  description="Track your own quarterly Have I Been Pwned checks across every email address and alias you use — a self-managed local checklist, no lookups performed by this page."
  ogDescription="Track your own quarterly Have I Been Pwned checks across every email address and alias you use — a self-managed local checklist."
  path="breach-check-tracker/"
  current="breach-check"
  accent="blue"
>
<style slot="head" is:global>
  /* Breach Check Tracker-only overrides + layout. Shared tokens/nav/brand live in shared/.
     is:global — this page creates address rows/history entries via JS at runtime. */
  body{padding-bottom:80px;}
  .wrap{max-width:1180px; margin:0 auto;}

  header{
    display:flex; flex-wrap:wrap; gap:24px; justify-content:space-between; align-items:flex-end;
    border-bottom:1px solid var(--border); padding-bottom:24px; margin-bottom:24px;
  }
  .eyebrow{font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:.16em; text-transform:uppercase;
    color:var(--blue); margin-bottom:10px; display:flex; align-items:center; gap:8px;}
  .eyebrow::before{content:"";width:6px;height:6px;background:var(--blue);border-radius:1px; display:inline-block;}
  h1{font-family:'Space Grotesk', sans-serif; font-size:clamp(28px,4vw,42px); font-weight:700; margin:0;
    letter-spacing:-.01em; line-height:1.05;}
  h1 span{color:var(--muted); font-weight:500;}
  .sub{color:var(--muted); font-size:14.5px; margin-top:10px; max-width:600px; line-height:1.5;}

  .reset-btn{
    font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--muted);
    background:var(--surface); border:1px solid var(--border); border-radius:8px;
    padding:10px 14px; cursor:pointer; height:fit-content; letter-spacing:.03em;
    transition:all .15s ease; appearance:none; -webkit-appearance:none; margin:0;
  }
  .reset-btn:hover{color:var(--text); border-color:#374252;}
  .reset-btn:focus-visible, #exportBtn:focus-visible{outline:2px solid var(--blue); outline-offset:1px;}

  .intro-card{
    background:var(--surface); border:1px solid var(--border); border-radius:14px;
    padding:20px 22px; margin-bottom:24px; font-size:13.5px; line-height:1.65; color:var(--muted2);
  }
  .intro-card b{color:var(--text);}
  .intro-card .links{display:flex; flex-wrap:wrap; gap:10px; margin-top:14px;}
  .intro-card .links a{
    font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--text); text-decoration:none;
    background:var(--surface2); border:1px solid var(--border); border-radius:7px; padding:8px 12px;
    display:inline-flex; align-items:center; gap:6px; transition:all .15s ease;
  }
  .intro-card .links a:hover{border-color:#374252; background:var(--surface3);}

  .layout{display:grid; grid-template-columns:1fr 320px; gap:28px;}
  @media (max-width:900px){.layout{grid-template-columns:1fr;} .sidebar{order:-1;}}

  .list-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;}
  .list-head-title{font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted2);}

  .add-row{
    background:var(--surface); border:1px solid var(--border); border-radius:14px;
    padding:14px; margin-bottom:12px; display:flex; gap:10px; align-items:center;
  }
  .add-row input{
    flex:1; background:var(--surface2); color:var(--text); border:1px solid var(--border);
    border-radius:8px; padding:10px 12px; font-family:'IBM Plex Sans',sans-serif; font-size:13.5px;
  }
  .add-row input:focus-visible{outline:2px solid var(--blue); outline-offset:1px;}
  .add-row button{
    font-family:'IBM Plex Mono',monospace; font-size:12px; font-weight:600; color:#0f1419;
    background:var(--blue); border:1px solid var(--blue); border-radius:8px; padding:10px 16px;
    cursor:pointer; white-space:nowrap; appearance:none; -webkit-appearance:none;
  }
  .add-row button:hover{opacity:.9;}
  .add-row button:focus-visible{outline:2px solid var(--blue); outline-offset:2px;}

  .empty-state{
    background:var(--surface); border:1px dashed var(--border); border-radius:14px;
    padding:32px 20px; text-align:center; color:var(--muted); font-size:13.5px; line-height:1.6;
  }

  .addr-row{
    background:var(--surface); border:1px solid var(--border); border-radius:14px;
    padding:16px 18px; margin-bottom:12px; display:flex; gap:14px; align-items:flex-start;
  }
  .addr-row.done{border-color:#3ddc9744;}
  .addr-row input[type=checkbox]{
    appearance:none; width:20px; height:20px; border-radius:6px; border:1.5px solid var(--muted2);
    background:var(--surface2); flex-shrink:0; margin-top:2px; cursor:pointer; position:relative;
    transition:all .15s ease;
  }
  .addr-row input[type=checkbox]:checked{background:var(--teal); border-color:var(--teal);}
  .addr-row input[type=checkbox]:checked::after{
    content:""; position:absolute; left:6px; top:2px; width:5px; height:10px;
    border:solid #0f1419; border-width:0 2px 2px 0; transform:rotate(45deg);
  }
  .addr-body{flex:1; min-width:0;}
  .addr-top{display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:5px;}
  .addr-label{font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:15.5px; word-break:break-all;}
  .addr-row.done .addr-label{color:var(--muted);}
  .addr-meta{display:flex; flex-wrap:wrap; gap:14px; align-items:center; font-size:12px;}
  .addr-meta a{color:var(--blue); font-family:'IBM Plex Mono',monospace; font-size:12px; text-decoration:none; font-weight:500;}
  .addr-meta a:hover{text-decoration:underline;}
  .addr-checked-on{color:var(--muted2); font-family:'IBM Plex Mono',monospace; font-size:11.5px;}
  .addr-remove{
    background:none; border:none; color:var(--muted2); cursor:pointer; font-size:16px;
    padding:2px 6px; flex-shrink:0; appearance:none; -webkit-appearance:none; line-height:1;
  }
  .addr-remove:hover{color:var(--red);}
  .addr-remove:focus-visible{outline:2px solid var(--red); outline-offset:1px;}

  .sidebar{position:sticky; top:80px; align-self:start; display:flex; flex-direction:column; gap:16px;}
  /* Below the breakpoint above, .sidebar gets order:-1 and stacks above the main content
     in a single column. position:sticky no longer serves its side-by-side purpose there,
     and actively breaks the page: as the user scrolls, the "stuck" sidebar overlaps and
     obscures whatever main-content row happens to be underneath it (confirmed via
     Playwright elementFromPoint + screenshot — checklist items were unreadable/unclickable
     behind the sidebar cards). Un-stick it — this has to come *after* the base .sidebar
     rule above, not inside the earlier @media block next to `order:-1`, since same-specificity
     CSS resolves by source order regardless of media-query nesting; placed earlier, the
     later unconditional rule above would win and silently no-op this override. */
  @media (max-width:900px){ .sidebar{position:static; top:auto;} }
  .card{background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:20px;}
  .card-title{font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--muted2); margin-bottom:14px;}

  .score-row{display:flex; justify-content:space-between; align-items:baseline; margin-top:14px;}
  .score-num{font-family:'Space Grotesk',sans-serif; font-size:32px; font-weight:700;}
  .score-label{font-size:12px; color:var(--muted);}

  .metric{display:flex; justify-content:space-between; padding:10px 0; border-top:1px solid var(--border-soft); font-size:13px;}
  .metric:first-of-type{border-top:none;}
  .metric .k{color:var(--muted);}
  .metric .v{font-family:'IBM Plex Mono',monospace; font-weight:600;}
  .v.red{color:var(--red);} .v.amber{color:var(--amber);} .v.teal{color:var(--teal);}

  .card p.small{font-size:12.5px; color:var(--muted2); line-height:1.6; margin:0 0 12px;}
  .card p.small:last-child{margin-bottom:0;}
  .history-list{display:flex; flex-direction:column; gap:8px; max-height:220px; overflow-y:auto;}
  .history-item{background:var(--surface2); border:1px solid var(--border); border-radius:8px; padding:8px 10px; font-size:12px;}
  .history-item .h-date{font-family:'IBM Plex Mono',monospace; color:var(--muted2); font-size:10.5px; margin-bottom:3px;}
  .history-item .h-summary{color:var(--text); line-height:1.4;}
  .history-empty{font-size:12px; color:var(--muted2); font-style:italic;}
  .card a.card-link{
    display:block; text-align:center; padding:11px; cursor:pointer; background:var(--surface3);
    border:1px solid var(--border); border-radius:8px; font-family:'IBM Plex Mono',monospace;
    font-size:12px; color:var(--text); text-decoration:none; transition:all .15s ease;
  }
  .card a.card-link:hover{border-color:#374252;}
  button#exportBtn{width:100%;}

  footer{margin-top:32px; padding-top:20px; border-top:1px solid var(--border);
    font-size:12.5px; color:var(--muted2); line-height:1.6;}
  footer b{color:var(--muted);}
</style>

<div class="wrap">

  <header>
    <div>
      <div class="eyebrow">Self-audit · <span id="itemCount">0</span> addresses tracked</div>
      <h1>Breach <span>Check Tracker</span></h1>
      <div class="sub">List every email address and alias you actually use, then check each one on Have I Been Pwned yourself once a quarter. This page never looks anything up for you — it only remembers which addresses you've checked and when.</div>
    </div>
    <button type="button" class="reset-btn" id="resetBtn">Reset tracker</button>
  </header>

  <div class="intro-card">
    <b>Why this exists:</b> Domain 1 and Domain 8 of the Playbook both recommend a Have I Been Pwned check as a free, do-this-first step — but until now nothing on this site made that a trackable habit the way the Broker Removal Tracker does for opt-outs. This tool deliberately does <b>not</b> query any breach database itself: it would need a backend and your email to do that server-side, which is exactly the kind of feature Spidergraph's own scope rules out (see the Playbook, or CLAUDE.md if you're a contributor). Instead, add your own addresses below, click through to Have I Been Pwned to check each one yourself, and tick it off — same shape as the rest of this site: you provide the input, you do the verification, this page just remembers your progress.
    <div class="links">
      <a href="https://haveibeenpwned.com/" target="_blank" rel="noopener">🔍 Open Have I Been Pwned →</a>
      <a href="../playbook/#8-osint-digital-footprint">📖 Read Domain 8 in the Playbook →</a>
    </div>
  </div>

  <div class="layout">
    <div>
      <div class="list-head"><span class="list-head-title">Your addresses</span></div>

      <div class="add-row">
        <input type="text" id="addrInput" placeholder="you@example.com or an alias label" aria-label="Email address or alias to track" maxlength="120">
        <button type="button" id="addBtn">Add</button>
      </div>

      <div id="emptyState" class="empty-state" hidden>Nothing tracked yet — add an email address or alias above to start your quarterly Have I Been Pwned habit.</div>
      <div id="addrList"></div>
    </div>

    <div class="sidebar">
      <div class="card">
        <div class="card-title">Progress</div>
        <div class="score-row">
          <div>
            <div class="score-num" id="scoreNum">0%</div>
            <div class="score-label">checked this cycle</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Summary</div>
        <div class="metric"><span class="k">Checked</span><span class="v teal" id="mDone">0/0</span></div>
        <div class="metric"><span class="k">Not checked</span><span class="v amber" id="mTodo">0</span></div>
      </div>

      <div class="card">
        <div class="card-title">Companion tool</div>
        <p class="small">This tracks your own addresses. If it's a listing on a people-search site instead of a breach, that's the Broker Removal Tracker's job, not this one.</p>
        <a class="card-link" href="../broker-removal-tracker/">Broker Removal Tracker →</a>
      </div>

      <div class="card">
        <div class="card-title">Export</div>
        <button type="button" id="exportBtn" class="reset-btn">Export progress ↓</button>
      </div>

      <div class="card">
        <div class="card-title">History</div>
        <p class="small">Save a dated checkpoint to compare your progress over time.</p>
        <button type="button" id="snapshotBtn" class="reset-btn" style="width:100%; margin-bottom:12px;">Save snapshot</button>
        <div id="historyList" class="history-list"></div>
      </div>
    </div>
  </div>

  <footer>
    <b>Companion pages:</b> the "why" behind this habit lives in Domains 1 and 8 of the <b>Playbook</b>. Your address list and checked/unchecked state stay in this browser only, in <code>localStorage</code> — nothing is sent anywhere, and this page never transmits an address you enter to Have I Been Pwned or anywhere else; it only opens a link you click yourself. <b>Reset tracker</b> clears everything.
  </footer>

</div>

<script src={`${base}shared/persist.js`} is:inline></script>
<script src={`${base}shared/history.js`} is:inline></script>
<script is:inline>
const store = spidergraphStore("spidergraph-breach-check-v1");
const saved = store.load();
let items = (saved && saved.data && Array.isArray(saved.data)) ? saved.data : [];

const listEl = document.getElementById("addrList");
const emptyEl = document.getElementById("emptyState");
const addrInput = document.getElementById("addrInput");

function makeId(){ return "addr-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 7); }

function renderList(){
  listEl.innerHTML = "";
  emptyEl.hidden = items.length > 0;
  items.forEach(it => {
    // <label>, not <div>: makes the whole row a tap target on mobile, not just the raw
    // 20x20px checkbox (which is below WCAG's 24x24px minimum on its own) — matches the
    // OPSEC Field Manual's checklist rows, which already use this pattern. Native label
    // click-forwarding correctly skips the link and the remove button inside it, so
    // tapping either of those still does its own thing rather than also toggling the box.
    const row = document.createElement("label");
    row.className = "addr-row" + (it.checked ? " done" : "");
    row.id = "row-" + it.id;
    row.innerHTML = `
      <input type="checkbox" id="cb-${it.id}" ${it.checked ? "checked" : ""} aria-label="Mark ${it.label} as checked this cycle">
      <div class="addr-body">
        <div class="addr-top">
          <span class="addr-label">${escapeHtml(it.label)}</span>
        </div>
        <div class="addr-meta">
          <a href="https://haveibeenpwned.com/" target="_blank" rel="noopener">Check on Have I Been Pwned →</a>
          ${it.checkedOn ? `<span class="addr-checked-on">Last checked ${it.checkedOn}</span>` : ""}
        </div>
      </div>
      <button type="button" class="addr-remove" aria-label="Remove ${it.label}" title="Remove">✕</button>
    `;
    listEl.appendChild(row);

    const cb = row.querySelector("input[type=checkbox]");
    cb.addEventListener("change", () => {
      it.checked = cb.checked;
      it.checkedOn = cb.checked ? new Date().toLocaleDateString('en-US', {year:'numeric', month:'short', day:'numeric'}) : it.checkedOn;
      row.classList.toggle("done", cb.checked);
      store.save(items);
      renderList();
      renderScore();
    });

    row.querySelector(".addr-remove").addEventListener("click", () => {
      items = items.filter(x => x.id !== it.id);
      store.save(items);
      renderList();
      renderScore();
    });
  });
}

function escapeHtml(s){
  const div = document.createElement("div");
  div.textContent = s;
  return div.innerHTML;
}

function renderScore(){
  const done = items.filter(it => it.checked).length;
  const total = items.length;
  const pct = total > 0 ? Math.round((done / total) * 100) : 0;
  document.getElementById("itemCount").textContent = total;
  document.getElementById("scoreNum").textContent = `${pct}%`;
  document.getElementById("mDone").textContent = `${done}/${total}`;
  document.getElementById("mTodo").textContent = total - done;
}

function addItem(){
  const label = addrInput.value.trim();
  if(!label) return;
  items.push({id: makeId(), label, checked:false, checkedOn:null});
  store.save(items);
  addrInput.value = "";
  renderList();
  renderScore();
  addrInput.focus();
}

document.getElementById("addBtn").addEventListener("click", addItem);
addrInput.addEventListener("keydown", e => { if(e.key === "Enter") addItem(); });

document.getElementById("resetBtn").addEventListener("click", () => {
  items = [];
  store.clear();
  renderList();
  renderScore();
});

document.getElementById("exportBtn").addEventListener("click", () => {
  const now = new Date().toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'});
  let lines = [];
  lines.push("BREACH CHECK TRACKER — PROGRESS EXPORT");
  lines.push(`Generated ${now}`);
  lines.push("=".repeat(60));
  lines.push("");
  if(items.length === 0){
    lines.push("(no addresses tracked yet)");
  } else {
    items.forEach(it => {
      lines.push(`[${it.checked ? "x" : " "}] ${it.label}${it.checkedOn ? ` — last checked ${it.checkedOn}` : ""}`);
    });
  }
  const done = items.filter(it => it.checked).length;
  lines.push("");
  lines.push("-".repeat(60));
  lines.push(`Checked: ${done}/${items.length}`);
  lines.push("");
  lines.push("Checks were performed manually by you at haveibeenpwned.com —");
  lines.push("this export only reflects what you told this page, nothing was");
  lines.push("looked up automatically.");

  const blob = new Blob([lines.join("\n")], {type:"text/plain"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `breach-check-progress-${Date.now()}.txt`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
});

const history = spidergraphHistory("spidergraph-breach-check-v1");

function renderHistory(){
  const snapshots = history.list().slice().reverse();
  const el = document.getElementById("historyList");
  if(snapshots.length === 0){
    el.innerHTML = '<div class="history-empty">No snapshots yet — save one to start tracking progress over time.</div>';
    return;
  }
  el.innerHTML = snapshots.map(s => {
    const d = new Date(s.date).toLocaleDateString('en-US', {year:'numeric', month:'short', day:'numeric'});
    return `<div class="history-item"><div class="h-date">${d}</div><div class="h-summary">${s.summary}</div></div>`;
  }).join("");
}

document.getElementById("snapshotBtn").addEventListener("click", () => {
  const done = items.filter(it => it.checked).length;
  const summary = items.length === 0
    ? "No addresses tracked"
    : `${done}/${items.length} addresses checked (${Math.round((done / items.length) * 100)}%)`;
  history.save(summary, items);
  renderHistory();
});

renderList();
renderScore();
renderHistory();
</script>
</BaseLayout>
