---
// Single source of truth for the top nav — this component is the whole reason for the
// Astro migration (see CLAUDE.md "Site navigation" and SESSION-NOTES.md for the history): the brand SVG and the
// Tools ▾ dropdown used to be hand-copied into all 9 page shells.
//
// `current` selects which link (or which tool inside the dropdown) renders with
// class="current". Tool pages pass both a tool id AND get the "Tools" summary itself
// marked current automatically.
//
// The dropdown panel is deliberately built from the site's own recurring motifs rather
// than being a plain link list: the accent-colored square dot + uppercase mono label is
// the same `.eyebrow::before` pattern used on every page's own header, and each tool's
// code ("TOOL-01" etc.) + one-line blurb echo the homepage grid cards and "Your
// Spidergraph" summary — so the panel reads as "a compact version of the homepage," not
// a different component vocabulary bolted onto the nav.
const TOOLS = [
  { id: 'stack-builder', label: 'Stack Builder', href: 'privacy-stack-builder/', code: 'TOOL-01', accent: 'teal', blurb: 'Product picks, tiers, radar chart' },
  { id: 'opsec', label: 'OPSEC Field Manual', href: 'opsec-field-manual/', code: 'TOOL-02', accent: 'amber', blurb: 'Behavioral audit, 44 controls' },
  { id: 'broker-tracker', label: 'Broker Removal Tracker', href: 'broker-removal-tracker/', code: 'TOOL-03', accent: 'red', blurb: 'Opt out of people-search sites' },
  { id: 'breach-check', label: 'Breach Check Tracker', href: 'breach-check-tracker/', code: 'TOOL-04', accent: 'blue', blurb: 'Track your own HIBP checks' },
  { id: 'digital-legacy', label: 'Digital Legacy Worksheet', href: 'digital-legacy-worksheet/', code: 'TOOL-05', accent: 'amber', blurb: 'Emergency access, no live passwords' },
  { id: 'incident-response', label: 'Incident Response Card', href: 'incident-response-card/', code: 'TOOL-06', accent: 'amber', blurb: 'Printable fraud-line wallet card' },
];
const TOOL_GROUPS = [
  { label: 'Domain audits', ids: ['stack-builder', 'opsec'] },
  { label: 'Trackers', ids: ['broker-tracker', 'breach-check'] },
  { label: 'Worksheets', ids: ['digital-legacy', 'incident-response'] },
];

interface Props {
  current: 'home' | 'playbook' | 'report' | typeof TOOLS[number]['id'];
  noPrint?: boolean;
}
const { current, noPrint = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const isTool = TOOLS.some(t => t.id === current);
---
<nav class:list={['topnav', { 'no-print': noPrint }]}>
  <div class="topnav-inner">
    <a href={base} class="brand">
      <svg width="26" height="26" viewBox="0 0 120 120" aria-hidden="true">
        <polygon points="60,28 82.63,37.37 92,60 82.63,82.63 60,92 37.37,82.63 28,60 37.37,37.37" fill="none" stroke="#2b3542" stroke-width="2"/>
        <g stroke="#2b3542" stroke-width="2">
          <line x1="60" y1="60" x2="60" y2="12"/><line x1="60" y1="60" x2="93.94" y2="26.06"/>
          <line x1="60" y1="60" x2="108" y2="60"/><line x1="60" y1="60" x2="93.94" y2="93.94"/>
          <line x1="60" y1="60" x2="60" y2="108"/><line x1="60" y1="60" x2="26.06" y2="93.94"/>
          <line x1="60" y1="60" x2="12" y2="60"/><line x1="60" y1="60" x2="26.06" y2="26.06"/>
        </g>
        <polygon points="60,16 75.56,44.44 98,60 81.21,81.21 60,106 47.27,72.73 26,60 41.62,41.62"
                 fill="#3ddc97" fill-opacity="0.3" stroke="#3ddc97" stroke-width="4"/>
      </svg><span class="brand-word">SPIDER<span>GRAPH</span></span>
    </a>
    <a href={base} class={current === 'home' ? 'current' : ''}>Home</a><span class="sep">/</span>
    <a href={`${base}playbook/`} class={current === 'playbook' ? 'current' : ''}>Playbook</a><span class="sep">/</span>
    <details class="nav-tools">
      <summary class={isTool ? 'current' : ''}>Tools</summary>
      <div class="nav-tools-panel">
        {TOOL_GROUPS.map(group => (
          <div class="nav-tools-group">
            <div class="nav-tools-group-label">{group.label}</div>
            {group.ids.map(id => {
              const tool = TOOLS.find(t => t.id === id)!;
              return (
                <a href={`${base}${tool.href}`} class:list={['nav-tools-item', { current: current === tool.id }]}>
                  <span class:list={['nav-tools-dot', tool.accent]}></span>
                  <span class="nav-tools-item-text">
                    <span class="nav-tools-item-top">
                      <span class="nav-tools-item-label">{tool.label}</span>
                      <span class:list={['nav-tools-item-code', tool.accent]}>{tool.code}</span>
                    </span>
                    <span class="nav-tools-item-blurb">{tool.blurb}</span>
                  </span>
                </a>
              );
            })}
          </div>
        ))}
      </div>
    </details>
    <span class="sep">/</span>
    <a href={`${base}report/`} class={current === 'report' ? 'current' : ''}>Recommendations Report</a>
  </div>
</nav>
<script src={`${base}shared/nav.js`} is:inline></script>
